#!/usr/bin/env bash
# pick a project (the dotfiles, or <workspace>/<group>/<project>) and open or switch to its
# tmux session. tmux runs it in a popup (prefix m), but it works from a plain shell too.

WORKSPACE="${WORKSPACE:-$HOME/code}"
DOTFILES="${DOTFILES:-$WORKSPACE/.dotfiles}"

selected=$(
  {
    echo "$DOTFILES"
    find "$WORKSPACE"/* -mindepth 1 -maxdepth 1 -type d -not -path '*/.*'
  } | sed "s|^$HOME|~|" | fzf --border-label " select session "
)
[[ -z $selected ]] && exit 0

path=${selected/#\~/$HOME}
session_name=${path#"$WORKSPACE"/}
session_name=${session_name//./_}   # tmux doesn't allow dots in session names

# "=" makes the match exact (otherwise "api" would match "api-gateway")
if ! tmux has-session -t "=$session_name" 2>/dev/null; then
  tmux new-session -ds "$session_name" -c "$path"
fi

if [[ -n $TMUX ]]; then
  tmux switch-client -t "=$session_name"
else
  tmux attach -t "=$session_name"
fi
