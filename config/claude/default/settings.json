{
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.config/claude/default/statusline.sh",
    "refreshInterval": 30
  },
  "outputStyle": "Concise",
  "model": "opus[1m]",
  "skipWorkflowUsageWarning": true,
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
